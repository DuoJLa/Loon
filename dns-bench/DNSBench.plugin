#!name = DNS Bench
#!desc = DNS 服务器延迟测速 · 内置 23 台国内外 DNS(含 IPv6 与 DoH/DoH3/DoQ),本地 WebUI 展示与策略组切换
#!author = Min
#!homepage = https://nsloon.app
#!icon = https://raw.githubusercontent.com/Loon0x00/LoonExampleConfig/master/Icon/dns.png
#!system = iOS,iPadOS,tvOS,macOS
#!system_version = 15
#!loon_version = 3.5.1(988)
#!date = 2026-10-30
#!tag = 工具,测速
#!type = normal

[Argument]
# 测速流量经此策略组出网(需在主配置 [Proxy Group] 中存在)
policy_group = input,"DNS 测速",type=string,tag=策略组,desc=测速请求使用的策略组名称
rounds = select,1,2,3,5,type=number,tag=测速轮数,desc=每台 DNS 测试轮数,取最小值

[Script]
# 本地 WebUI:http://dns.bench.local
request if ${url} ~= /^https?:\/\/dns\.bench\.local\// then script("dns-bench.js") with tag="DNSBench", timeout=120, requires_body=false

[Host]
# 让 dns.bench.local 指向回环地址,避免真实 DNS 查询
dns.bench.local = 127.0.0.1
